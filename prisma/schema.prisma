generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SenderRole {
  DEV
  CLIENT
}

model Project {
  id        String        @id @default(uuid())
  title     String
  taxRate   Decimal       @default(0.00) @db.Decimal(5, 2)
  status    ProjectStatus @default(DRAFT)
  currency  String        @default("USD")
  contract  Json?         // { description, milestones: [], clientNames: [], devName, createdAt, status: 'draft'|'sent'|'confirmed' }
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  projectClients ProjectClient[]
  milestones    Milestone[]
  messages      Message[]
  expenses      Expense[]
  invoices     Invoice[]
  agentLogs    AgentLog[]
}

model Client {
  id          String   @id @default(uuid())
  name        String
  email       String?
  platform    String?
  createdAt   DateTime @default(now())

  projectClients ProjectClient[]
}

model ProjectClient {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())

  @@unique([projectId, clientId])
}

model Milestone {
  id        String    @id @default(uuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal   @db.Decimal(12, 2)
  dueDate   DateTime?
  isPaid    Boolean   @default(false)
  order     Int       @default(0)
}

model Message {
  id         String     @id @default(uuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderRole SenderRole
  senderName String
  content    String     @db.Text
  createdAt  DateTime   @default(now())
}

model Expense {
  id          String    @id @default(uuid())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  description String
  amount      Decimal   @db.Decimal(12, 2)
  category    String?
  date        DateTime  @default(now())
}

model Invoice {
  id            String        @id @default(uuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  stage         Int           @default(1)
  dueDate       DateTime?
  items         InvoiceItem[]
  createdAt     DateTime      @default(now())
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  amount      Decimal @db.Decimal(12, 2)
}

model AgentLog {
  id        String   @id @default(uuid())
  action    String
  message   String
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  severity  String
  createdAt DateTime @default(now())
}